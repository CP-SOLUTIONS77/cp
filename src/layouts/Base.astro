---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarreAction from '../components/BarreAction.astro';
import { localBusiness, webSite } from '../lib/schema.ts';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  /** Balisage JSON-LD propre à la page, en plus de LocalBusiness et WebSite. */
  schema?: unknown | unknown[];
}

const { schema, ...seo } = Astro.props;

const schemas = [
  localBusiness(),
  webSite(),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f3f2ed" />
    <meta name="google-site-verification" content="SR9fOGVKZ21naqkKyjWkfWQ7r-D4-gvuezeTMwzfm7k" />

    <!--
      Les deux polices sont sur le chemin critique du premier rendu : la
      grotesque porte le titre du hero (le LCP), la chasse fixe porte le numéro
      de téléphone du header.
    -->
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo {...seo} />
    <JsonLd data={schemas} />
    <SpeedInsights />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L89Y0B39NF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-L89Y0B39NF");
    </script>
    <script>
      const SITES = [
        'cpsolutions77.com',
        'monpretassure.fr',
        'monrachatcredit.fr',
        'monautoassure.fr',
        'monhabitationassure.fr',
      ];
      const PRODUITS: Record<string, string> = {
        '3a2004aa': 'auto',
        de4ba9f1: 'moto',
        '784ba6a2': 'habitation',
        a4bdbd13: 'sante',
        '312e7013': 'sante_animale',
        '06e1eedf': 'decennale',
        '92057954': 'dommage_ouvrage',
      };

      function envoyer(nom: string, params: Record<string, string>) {
        window.dataLayer = window.dataLayer || [];
        function gtag(..._args: unknown[]) {
          window.dataLayer.push(arguments);
        }
        gtag('event', nom, params);
      }

      document.addEventListener('click', (e) => {
        const lien = (e.target as Element | null)?.closest('a');
        if (!lien) return;

        const href = lien.getAttribute('href') ?? '';
        const page = window.location.pathname;

        if (href.startsWith('tel:')) return envoyer('click_telephone', { page });
        if (href.startsWith('mailto:')) return envoyer('click_email', { page });

        let url: URL;
        try {
          url = new URL(lien.href, window.location.href);
        } catch {
          return;
        }

        if (url.hostname.includes('calendly.com')) return envoyer('click_rendez_vous', { page });
        if (url.hostname.includes('lyaprotect.com')) {
          const id = (url.searchParams.get('id') ?? '').slice(0, 8);
          return envoyer('click_devis_en_ligne', { page, produit: PRODUITS[id] ?? 'autre' });
        }
        if (url.hostname.includes('assurdistribution.fr')) {
          return envoyer('click_devis_en_ligne', { page, produit: 'emprunteur' });
        }

        const cible = url.hostname.replace(/^www\./, '');
        const courant = window.location.hostname.replace(/^www\./, '');
        if (cible !== courant && SITES.includes(cible)) {
          envoyer('click_site_interne', { page, destination: cible });
        }
      });
    </script>
  </head>

  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <BarreAction />
  </body>
</html>
