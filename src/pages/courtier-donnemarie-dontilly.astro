---
import Ville from '../layouts/Ville.astro';
import { googleReviews } from '../config/site.ts';

const faq = [
  {
    question: "Un client me demande mon attestation décennale avant de signer, est-ce normal ?",
    answer:
      "Oui, c'est même une obligation : l'attestation d'assurance décennale doit être jointe aux devis et aux factures des professionnels du bâtiment concernés. Si vous n'en avez pas encore, nous vous aidons à souscrire un contrat adapté à vos activités.",
  },
  {
    question: "Mon utilitaire est-il assuré quand je transporte mon matériel ?",
    answer:
      "Cela dépend de l'usage déclaré au contrat. Un usage professionnel doit être mentionné, et l'outillage transporté n'est pas toujours couvert en cas de vol. Nous vérifions ces points avec vous.",
  },
  {
    question: "Assurez-vous aussi les particuliers ?",
    answer:
      "Oui. Habitation, auto, mutuelle, prêt immobilier, assurance emprunteur : nous accompagnons aussi les familles, y compris celles des professionnels que nous assurons.",
  },
];
---

<Ville
  slug="courtier-donnemarie-dontilly"
  title={"Courtier assurance pro et particulier à Donnemarie-Dontilly"}
  description={"Courtier indépendant pour Donnemarie-Dontilly et Montigny-Lencoup : décennale, RC pro, assurance des artisans, habitation, prêt immobilier. Étude gratuite."}
  h1={"Courtier en assurance pour les artisans et les particuliers à Donnemarie-Dontilly"}
  chapeau={"À Donnemarie-Dontilly, Montigny-Lencoup, Thénisy ou Gurcy-le-Châtel, beaucoup d'habitants sont artisans, indépendants ou chefs de petite entreprise. CP Solutions, courtier indépendant installé à Montereau-Fault-Yonne, à environ 20 minutes, assure votre activité comme votre famille, avec un interlocuteur qui connaît votre dossier."}
  venir={"À environ 20 minutes en voiture de Donnemarie-Dontilly. Entre deux chantiers, un appel ou un e-mail suffit : nous gérons l'essentiel à distance."}
  faq={faq}
>
  <h2>Artisans du bâtiment : votre décennale</h2>
  <p>Maçon, couvreur, plombier, électricien, menuisier : la décennale est obligatoire et vos clients vous demandent l'attestation avant de signer. Encore faut-il qu'elle couvre toutes les activités que vous exercez réellement. Nous vérifions votre contrat actuel et comparons plusieurs assureurs partenaires.</p>
  <h2>Les autres contrats de votre entreprise</h2>
  <ul>
  <li><strong>RC professionnelle</strong> : les dommages causés à vos clients ou à des tiers pendant votre travail.</li>
  <li><strong>Multirisque professionnelle</strong> : atelier, dépôt, outillage, stock.</li>
  <li><strong>Véhicule utilitaire</strong> : un usage professionnel correctement déclaré.</li>
  <li><strong>Prévoyance du dirigeant</strong>, pour protéger vos revenus en cas d'arrêt.</li>
  </ul>
  <p class="liens">→ <a href="/assurances/professionnels">Assurances professionnelles</a></p>
  <h2>Et pour la maison</h2>
  <p>Assurance habitation, auto, mutuelle familiale, prêt immobilier pour acheter ou rénover : nous gérons aussi vos contrats personnels, pour que vous n'ayez qu'un seul interlocuteur.</p>
  <p class="liens">→ <a href="/assurances/habitation">Habitation</a> · <a href="/assurances/auto-moto">Auto-moto</a> · <a href="/credits/immobilier">Prêt immobilier</a></p>
  <h2>Pourquoi CP Solutions ?</h2>
  <ul>
  <li><strong>Réactif</strong> : une attestation ou un avenant ne peut pas attendre une semaine.</li>
  <li><strong>Indépendant</strong> : nous mettons plusieurs assureurs en concurrence.</li>
  <li><strong>Pro et perso</strong> chez le même courtier.</li>
  <li><strong>Noté {googleReviews.rating}/5 sur Google</strong>.</li>
  </ul>
</Ville>
