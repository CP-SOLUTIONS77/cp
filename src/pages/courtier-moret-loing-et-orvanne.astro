---
import Ville from '../layouts/Ville.astro';
import { googleReviews } from '../config/site.ts';

const faq = [
  {
    question: "Puis-je vous confier des contrats souscrits ailleurs ?",
    answer:
      "Oui. Nous pouvons étudier vos contrats actuels et, si une alternative vous convient mieux, nous occuper des démarches de changement, dans le respect des règles de résiliation applicables à chaque contrat.",
  },
  {
    question: "Peut-on changer de mutuelle en cours d'année ?",
    answer:
      "Après un an d'engagement, la plupart des contrats de complémentaire santé individuels peuvent être résiliés à tout moment. Nous vérifions avec vous les conditions de votre contrat.",
  },
  {
    question: "Faut-il prendre rendez-vous ?",
    answer:
      "Ce n'est pas obligatoire, mais c'est conseillé pour être reçu sans attente. Vous pouvez réserver un créneau en ligne ou nous appeler.",
  },
];
---

<Ville
  slug="courtier-moret-loing-et-orvanne"
  title={"Courtier assurance et crédit à Moret-Loing-et-Orvanne"}
  description={"Votre courtier en assurance et crédit à 10 minutes de Moret-sur-Loing et Veneux-les-Sablons. Mutuelle, auto, habitation, prêt immobilier, assurance emprunteur."}
  h1={"Votre courtier en assurance et en crédit à côté de Moret-Loing-et-Orvanne"}
  chapeau={"Moret-sur-Loing, Veneux-les-Sablons, Écuelles, Épisy, Montarlot : notre agence de Montereau-Fault-Yonne est à environ 10 minutes. CP Solutions est un courtier indépendant, et l'avantage d'être si proche est simple : vous pouvez passer nous voir, déposer un document ou poser une question de vive voix, sans prendre une demi-journée."}
  venir={"En voiture, comptez environ 10 minutes depuis Moret. Stationnement en zone bleue devant l'agence (disque obligatoire). En train, la gare de Moret-Veneux-les-Sablons est reliée à Montereau par la ligne R, et l'agence est à environ 10 minutes à pied de la gare de Montereau."}
  faq={faq}
>
  <h2>Tous vos contrats, un seul interlocuteur</h2>
  <p>Beaucoup de nos clients du secteur nous confient progressivement l'ensemble de leurs contrats. C'est plus simple : un seul contact quand il faut déclarer un sinistre, changer de voiture ou déménager.</p>
  <ul>
  <li><strong>Assurance auto et moto</strong>, y compris pour les profils résiliés, malussés ou à permis annulé.</li>
  <li><strong>Assurance habitation</strong>, pour propriétaires, locataires et bailleurs (PNO).</li>
  <li><strong>Mutuelle santé et prévoyance</strong>, pour les particuliers, les retraités et les indépendants.</li>
  <li><strong>Assurances diverses</strong> : animaux, camping-car, voyage.</li>
  </ul>
  <p class="liens">→ <a href="/assurances">Toutes nos assurances</a></p>
  <h2>Mutuelle : payer pour ce dont vous avez besoin</h2>
  <p>Les besoins en santé évoluent : arrivée d'un enfant, départ à la retraite, fin d'une mutuelle d'entreprise… C'est le bon moment pour comparer. Nous regardons avec vous vos postes de dépenses réels (optique, dentaire, hospitalisation) et cherchons une formule cohérente avec votre budget.</p>
  <p class="liens">→ <a href="/assurances/autres">Mutuelle et autres assurances</a></p>
  <h2>Acheter, renégocier, regrouper : vos crédits</h2>
  <ul>
  <li><strong>Prêt immobilier</strong> : capacité d'emprunt, mise en concurrence des banques, montage du dossier.</li>
  <li><strong>Assurance emprunteur</strong> : vous pouvez en changer à tout moment grâce à la loi Lemoine, à garanties équivalentes.</li>
  <li><strong>Rachat de crédit</strong> : regrouper plusieurs prêts en une seule mensualité, quand c'est réellement pertinent pour vous.</li>
  </ul>
  <p class="liens">→ <a href="/credits/immobilier">Prêt immobilier</a> · <a href="/assurance-emprunteur">Assurance emprunteur</a> · <a href="/credits/rachat-regroupement">Rachat de crédit</a></p>
  <h2>Commerçants, artisans, indépendants</h2>
  <p>Vous exercez à Moret ou aux alentours ? RC professionnelle, décennale, multirisque des locaux : nous assurons votre activité avec des contrats adaptés à votre métier, et nous restons joignables quand un problème survient.</p>
  <p class="liens">→ <a href="/assurances/professionnels">Assurances professionnelles</a></p>
  <h2>Pourquoi CP Solutions ?</h2>
  <ul>
  <li><strong>À 10 minutes</strong> : une vraie agence, pas une plateforme en ligne.</li>
  <li><strong>Indépendant</strong> : plusieurs assureurs et banques partenaires comparés.</li>
  <li><strong>Disponible</strong> : deux courtiers qui connaissent leurs clients.</li>
  <li><strong>Noté {googleReviews.rating}/5 sur Google</strong>.</li>
  </ul>
</Ville>
