---
import Ville from '../layouts/Ville.astro';
import { googleReviews } from '../config/site.ts';

const faq = [
  {
    question: "Comment se passe un changement d'assurance emprunteur ?",
    answer:
      "Vous choisissez un nouveau contrat aux garanties équivalentes à celles exigées par la banque, puis la demande de substitution lui est envoyée. La banque dispose de dix jours ouvrés pour répondre. Nous préparons le dossier et suivons la procédure avec vous.",
  },
  {
    question: "Je travaille en Île-de-France : cela change-t-il mon assurance auto ?",
    answer:
      "L'assureur tient compte de votre lieu de résidence, de l'usage du véhicule, notamment les trajets domicile-travail, et du kilométrage. Ces éléments doivent être déclarés correctement. Nous comparons les offres selon vos trajets réels.",
  },
  {
    question: "Puis-je tout faire à distance ?",
    answer:
      "Oui. La plupart des dossiers se traitent par téléphone et par e-mail. L'agence de Montereau reste à votre disposition si vous préférez nous rencontrer.",
  },
];
---

<Ville
  slug="courtier-pont-sur-yonne"
  title={"Courtier assurance et crédit à Pont-sur-Yonne"}
  description={"Courtier indépendant pour Pont-sur-Yonne, Villeneuve-la-Guyard et Champigny : assurance emprunteur, prêt immobilier, assurance auto, habitation. Étude gratuite."}
  h1={"Courtier en assurance et en crédit à Pont-sur-Yonne et Villeneuve-la-Guyard"}
  chapeau={"Entre Montereau et Sens, Pont-sur-Yonne, Villeneuve-la-Guyard, Champigny et Michery sont côté Yonne, mais à quelques minutes seulement de la Seine-et-Marne. Beaucoup d'habitants y vivent et travaillent en Île-de-France. CP Solutions, courtier indépendant, les accompagne depuis son agence de Montereau-Fault-Yonne, à environ 15 minutes de Villeneuve-la-Guyard et 20 minutes de Pont-sur-Yonne."}
  venir={"À environ 15 à 20 minutes en voiture. En train, Pont-sur-Yonne et Montereau sont sur la ligne Paris-Sens, et l'agence est à une dizaine de minutes à pied de la gare de Montereau."}
  faq={faq}
>
  <h2>Votre assurance emprunteur : souvent la première économie</h2>
  <p>Vous remboursez un prêt immobilier ? L'assurance emprunteur représente une part importante de son coût. Depuis la loi Lemoine, vous pouvez en changer à tout moment, à garanties équivalentes. Nous comparons votre contrat actuel, préparons la demande et la suivons auprès de votre banque.</p>
  <p class="liens">→ <a href="/assurance-emprunteur">Assurance emprunteur</a></p>
  <h2>Acheter dans le nord de l'Yonne</h2>
  <p>Département différent, même méthode : capacité d'emprunt, budget global, mise en concurrence de plusieurs banques partenaires et suivi du dossier jusqu'au notaire. La localisation du bien n'est pas un obstacle, nos partenaires financent partout en France.</p>
  <p class="liens">→ <a href="/credits/immobilier">Prêt immobilier</a> · <a href="/credits/rachat-regroupement">Rachat de crédit</a></p>
  <h2>Auto : des trajets qui comptent</h2>
  <p>Trajets domicile-travail vers l'Île-de-France, kilométrage élevé, deuxième voiture : ces éléments pèsent sur le tarif et doivent être bien déclarés. Nous comparons les offres en fonction de votre usage réel, y compris pour les profils résiliés ou malussés.</p>
  <p class="liens">→ <a href="/assurances/auto-moto">Assurance auto-moto</a></p>
  <h2>Votre logement au bord de l'Yonne</h2>
  <p>Maison, appartement, logement loué : nous vérifions les garanties de votre assurance habitation, notamment catastrophes naturelles et dégâts des eaux, et comparons plusieurs assureurs.</p>
  <p class="liens">→ <a href="/assurances/habitation">Assurance habitation</a></p>
  <h2>Pourquoi CP Solutions ?</h2>
  <ul>
  <li><strong>Tout près</strong>, même de l'autre côté de la limite départementale.</li>
  <li><strong>Indépendant</strong> : plusieurs partenaires comparés, aucun produit maison.</li>
  <li><strong>Suivi personnel</strong> : deux courtiers qui connaissent votre dossier.</li>
  <li><strong>Noté {googleReviews.rating}/5 sur Google</strong>.</li>
  </ul>
</Ville>
